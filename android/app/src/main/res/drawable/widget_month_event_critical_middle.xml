<?xml version="1.0" encoding="utf-8"?>
<!-- 중요 연속 일정 중간 셀: 상/하만 표시 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F3EEFF" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#7A5AC8" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:gravity="bottom"><shape android:shape="rectangle"><size android:height="1dp" /><solid android:color="#7A5AC8" /></shape></item>
</layer-list>
