<?xml version="1.0" encoding="utf-8"?>
<!-- 중요 연속 일정 종료 셀: 외곽(상/하/우)만 표시 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F3EEFF" />
            <corners
                android:topLeftRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:topRightRadius="4dp"
                android:bottomRightRadius="4dp" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#7A5AC8" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="4dp" />
        </shape>
    </item>
    <item android:gravity="bottom"><shape android:shape="rectangle"><size android:height="1dp" /><solid android:color="#7A5AC8" /></shape></item>
    <item android:gravity="right"><shape android:shape="rectangle"><size android:width="1dp" /><solid android:color="#7A5AC8" /></shape></item>
</layer-list>
