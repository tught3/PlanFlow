// Canonical Apple/Firebase identifiers for the PlanFlow release targets.
PLANFLOW_IOS_IDENTITY_STATUS = ACCOUNT_CONFIRMED_EXTERNAL_BUILD_REQUIRED
PLANFLOW_IOS_BUNDLE_ID = com.fluxstudio.planflow
PLANFLOW_IOS_WIDGET_BUNDLE_ID = $(PLANFLOW_IOS_BUNDLE_ID).PlanFlowWidget
PLANFLOW_IOS_APP_GROUP = group.com.fluxstudio.planflow
