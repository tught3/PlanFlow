# Flutter stable 3.47 and current Firebase/Maps pods require iOS 15 or newer.
# Keep the Podfile and generated pod targets aligned so CocoaPods can resolve
# the plugin on the macOS readiness runner.
platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# 90683 root-cause remediation (evidence: file_picker 11.0.2 ios podspec).
# By default file_picker defines PICKER_MEDIA=1, which (a) adds the
# DKImagePickerController/PhotoGallery pod and (b) compiles PHPicker /
# UIImagePickerController / <Photos/Photos.h> code paths into Runner.app.
# PlanFlow only calls FilePicker.pickFiles(type: FileType.custom) for .ics
# import (lib/screens/settings/naver_ics_import_screen.dart), so the media
# picker is dead surface. Apple BuildUpload 90683 ("Missing purpose string",
# affected bundle Runner.app) fires on that linked photo-library surface while
# Runner/Info.plist declares no NSPhotoLibraryUsageDescription.
# Removing the surface is preferred over declaring a purpose string for a
# capability the app does not use. Every PH*/UIImagePicker*/DKImagePicker*
# reference in file_picker 11.0.2 is inside `#ifdef PICKER_MEDIA`, so document
# and audio picking are unaffected. iOS-only; no Android impact.
Pod::PICKER_MEDIA = false

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get before pod install."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
