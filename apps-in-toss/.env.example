# 이 파일의 값은 전부 클라이언트 번들에 포함된다. service_role 키, 토스 mTLS
# 인증서/개인키, PII 복호화 키 등 서버 전용 시크릿은 여기에 절대 넣지 말고
# Supabase Edge Function secret으로 설정한다(scripts/scan-bundle.mjs가 빌드
# 산출물에서 이런 값이 새어 들어갔는지 차단한다).
#
# 서버 전용 시크릿 목록·설정 방법은 docs/toss-login-setup.md 참고.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 개발 미리보기 모드(src/features/devPreview/). 로컬 개발 서버(vite dev)에서만
# 동작하고, production 빌드(vite build)에서는 import.meta.env.DEV가 항상
# false로 치환되어 이 값과 무관하게 무조건 꺼진다(scripts/scan-bundle.mjs가
# 빌드 산출물에서 관련 마커가 새어나가지 않았는지 확인한다).
# 켜면 Supabase 로그인/조회를 전혀 거치지 않고 화면 상단 배너와 함께 메모리
# 안의 예시 일정(일반/중요/종일/반복/다일 일정)만으로 화면을 미리 볼 수 있다.
# 기본값은 비활성(빈 값 또는 미설정) - 켜려면 로컬 .env.local에 값을 1로 둔다.
VITE_DEV_PREVIEW=
