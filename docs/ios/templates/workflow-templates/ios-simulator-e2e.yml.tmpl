# =============================================================================
# TEMPLATE — NOT AN EXECUTABLE WORKFLOW
# -----------------------------------------------------------------------------
# 이 파일은 `docs/ios/templates/workflow-templates/` 아래에 있고 확장자가 `.yml.tmpl`
# 이므로 GitHub Actions가 워크플로로 인식하지 않는다. 절대 이 상태로
# `.github/workflows/` 에 복사하지 마라 — `{{...}}` 플레이스홀더가 남아 있어
# YAML 파싱 단계에서 실패한다.
#
# 사용법:
#   1) docs/ios/templates/PARAMETERS.md 의 모든 파라미터 값을 확정한다.
#   2) 이 파일의 `{{...}}` 를 전부 치환한다.
#   3) 기능 플래그가 false 인 블록은 주석 처리가 아니라 "삭제" 한다.
#   4) `.github/workflows/ios-simulator-e2e.yml` 로 저장한다.
#   5) `grep -n '{{' .github/workflows/ios-simulator-e2e.yml` 가 0건인지 확인한다.
#
# 설계 원칙(고칠 때도 유지):
#   - fail-closed: 값 없음/아티팩트 부재/파싱 실패는 전부 exit 1.
#   - 차단 사유는 `::error title=BLOCKED_*::` 라벨로 기계 판독 가능하게 낸다.
#   - 통과도 `<GATE>_PASS: PASS` 로 명시한다("조용히 통과"와 구분하기 위해).
#   - 비밀값은 존재여부/길이/SHA-256 만 출력한다. 원문은 절대 로그에 찍지 않는다.
# =============================================================================

name: iOS Simulator E2E ({{APP_NAME}})

on:
  workflow_dispatch:
  pull_request:
    paths:
      - 'lib/**'
      - 'ios/**'
      - 'integration_test/**'
      - 'scripts/ios/**'
      - '.github/workflows/ios-simulator-e2e.yml'

permissions:
  contents: read

concurrency:
  group: ios-simulator-e2e-${{ github.ref }}
  cancel-in-progress: true

jobs:
  simulator-e2e:
    # 러너 이미지를 고정한다 — `macos-latest` 를 쓰지 마라.
    #
    # 실측 근거(이 템플릿을 추출한 원본 앱): `macos-latest` 가 Xcode 26 세대로 올라간 뒤,
    # 벤더드 Swift pod 를 쓰는 앱의 시뮬레이터 빌드가 링크 단계에서 실패했다.
    # Xcode 26 이 제거한 Swift 호환 라이브러리를 pod 들이 여전히 요구하기 때문이다
    # (누락 심볼: swiftCompatibility56 / swiftCompatibilityConcurrency /
    #  swiftCompatibilityPacks / CoreAudioTypes / UIUtilities).
    # 원본 앱은 `macos-15`(Xcode 16 세대) 로 고정해 이 실패를 넘겼다.
    # 배치 후에는 `.github/workflows/ios-simulator-e2e.yml` 의 동일 주석을 유지하라.
    #
    # 주의 — 이 핀은 "영원히 macos-15"라는 뜻이 아니다. 러너 이미지는 결국 은퇴한다.
    # 이 값은 **만료되는 핀**이므로 아래 둘 중 하나가 발생하면 재검토한다:
    #   (a) 이미지 은퇴 공지  (b) 벤더드 pod 들이 새 Xcode 세대를 지원
    # 재검토 시에는 상위 이미지로 한 번에 올리지 말고, 새 이미지에서
    # 위 심볼 누락이 재현되는지 1회 실측한 뒤 올린다.
    #
    # 앱에 벤더드 Swift pod 가 전혀 없으면 더 최신 이미지를 써도 된다.
    # 그 판단은 이 템플릿이 대신 해줄 수 없으므로 앱마다 1회 실측한다.
    runs-on: macos-15
    timeout-minutes: 60
    env:
      # canonical identity — 이 값들은 ios/Flutter/{{APP_NAME}}-Identity.xcconfig 의
      # 단일 소스와 동일해야 하며, 아래 preflight 게이트가 그것을 대조한다.
      IOS_BUNDLE_ID: '{{BUNDLE_ID}}'
      IOS_WIDGET_BUNDLE_ID: '{{WIDGET_BUNDLE_ID}}'
      IOS_APP_GROUP: '{{APP_GROUP}}'
      IOS_URL_SCHEME: '{{URL_SCHEME}}'
      IOS_MIN_VERSION: '{{MIN_IOS_VERSION}}'
      IOS_DEVICE_FAMILY: '{{TARGETED_DEVICE_FAMILY}}'
      E2E_FLOWS: '{{E2E_FLOWS}}'
      BACKEND_KIND: '{{BACKEND_KIND}}'
      # 시뮬레이터 E2E 는 서명하지 않으므로 배포용 인증서/프로파일 시크릿을 쓰지 않는다.
      # 백엔드 설정 파일만 주입한다(HAS_* 및 BACKEND_KIND 에 따라 필요 여부가 갈린다).
      FIREBASE_PLIST_BASE64: ${{ secrets.{{SECRET_PREFIX}}_IOS_GOOGLE_SERVICE_INFO_PLIST_BASE64 }}
      BACKEND_URL: ${{ secrets.{{SECRET_PREFIX}}_BACKEND_URL }}
      BACKEND_ANON_KEY: ${{ secrets.{{SECRET_PREFIX}}_BACKEND_ANON_KEY }}
    steps:
      - uses: actions/checkout@v4

      - name: Preflight canonical identity gates
        shell: bash
        run: |
          set -euo pipefail

          # --- 1) Podfile / Xcode deployment target 이 선언 최소 버전과 일치하는가 ---
          podfile_target="$(sed -n "s/^platform :ios, '\([0-9.]*\)'.*/\1/p" ios/Podfile | head -n 1)"
          if [[ "$podfile_target" != "$IOS_MIN_VERSION" ]]; then
            echo "::error title=BLOCKED_MIN_IOS_MISMATCH::ios/Podfile declares '$podfile_target' but the canonical minimum is '$IOS_MIN_VERSION'."
            exit 1
          fi
          if ! grep -q "IPHONEOS_DEPLOYMENT_TARGET = $IOS_MIN_VERSION;" ios/Runner.xcodeproj/project.pbxproj; then
            echo "::error title=BLOCKED_MIN_IOS_MISMATCH::Xcode IPHONEOS_DEPLOYMENT_TARGET does not match '$IOS_MIN_VERSION'."
            exit 1
          fi

          # --- 2) 디바이스 패밀리가 QA 매트릭스의 회전/레이아웃 범위와 일치하는가 ---
          if ! grep -q "TARGETED_DEVICE_FAMILY = \"$IOS_DEVICE_FAMILY\";" ios/Runner.xcodeproj/project.pbxproj; then
            echo "::error title=BLOCKED_DEVICE_FAMILY::Xcode TARGETED_DEVICE_FAMILY does not match '$IOS_DEVICE_FAMILY'."
            exit 1
          fi

          # --- 3) URL scheme 이 Info.plist 에 실제로 선언돼 있는가 (딥링크 E2E 전제) ---
          if ! grep -q "<string>$IOS_URL_SCHEME</string>" ios/Runner/Info.plist; then
            echo "::error title=BLOCKED_URL_SCHEME::ios/Runner/Info.plist does not declare CFBundleURLSchemes entry '$IOS_URL_SCHEME'."
            exit 1
          fi

          # --- 4) 개인정보 usage description 키: 기능 플래그가 켜진 것만 요구한다 ---
          # HAS_MICROPHONE={{HAS_MICROPHONE}} / HAS_SPEECH={{HAS_SPEECH}}
          # HAS_PHOTOS={{HAS_PHOTOS}} / HAS_LOCATION={{HAS_LOCATION}}
          # HAS_ADS={{HAS_ADS}} / USES_TRACKING={{USES_TRACKING}}
          # 아래 목록에서 해당 기능이 false 인 앱은 그 줄을 삭제한다(주석 처리 금지).
          #
          # NSUserTrackingUsageDescription 은 HAS_ADS 와 USES_TRACKING 이 **서로 다른 질문**임에 주의한다:
          #   - HAS_ADS=true       : 광고 SDK 를 포함한다.
          #   - USES_TRACKING=true : 앱이 실제로 ATT 권한을 요청한다(ATTrackingManager 호출).
          # 광고 SDK 는 쓰지만 ATT 를 직접 호출하지 않는 앱이 실제로 존재한다.
          # 그런 앱도 이 키를 **삭제하면 안 된다** — 이 게이트와 릴리스 워크플로의
          # 동일 게이트가 즉시 BLOCKED_RUNNER_PRIVACY_SOURCE 로 빌드를 막고,
          # 키 없이 업로드하면 Apple 이 `90683 Missing purpose string` 으로 거부한 이력이 있다.
          # 즉 이 키의 존재는 "추적한다"의 증거가 아니라 "빌드가 통과하기 위한 전제"다.
          # HAS_ADS=false 이고 USES_TRACKING=false 인 앱만 이 줄을 삭제한다.
          required_privacy_keys=(
            NSMicrophoneUsageDescription           # HAS_MICROPHONE
            NSSpeechRecognitionUsageDescription    # HAS_SPEECH
            NSPhotoLibraryUsageDescription         # HAS_PHOTOS
            NSPhotoLibraryAddUsageDescription      # HAS_PHOTOS
            NSLocationWhenInUseUsageDescription    # HAS_LOCATION
            NSUserTrackingUsageDescription         # HAS_ADS 또는 USES_TRACKING
          )
          for privacy_key in "${required_privacy_keys[@]}"; do
            privacy_value="$(/usr/libexec/PlistBuddy -c "Print :$privacy_key" ios/Runner/Info.plist 2>/dev/null || true)"
            if [[ -z "$privacy_value" ]]; then
              echo "::error title=BLOCKED_RUNNER_PRIVACY_SOURCE::Runner Info.plist is missing $privacy_key."
              exit 1
            fi
          done

          # --- 5) 위젯이 있는 앱은 App Group 단일 소스가 존재해야 한다 ---
          # HAS_WIDGET={{HAS_WIDGET}} — false 인 앱은 이 블록 전체를 삭제한다.
          if ! grep -q "$IOS_APP_GROUP" ios/Runner/Runner.entitlements; then
            echo "::error title=BLOCKED_APP_GROUP::Runner.entitlements does not declare the canonical app group '$IOS_APP_GROUP'."
            exit 1
          fi
          if [[ "$IOS_WIDGET_BUNDLE_ID" == "$IOS_BUNDLE_ID" ]]; then
            echo "::error title=BLOCKED_IOS_IDENTITY::Widget bundle id must differ from the Runner bundle id."
            exit 1
          fi

          echo "IDENTITY_PREFLIGHT_PASS: PASS"

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: '{{FLUTTER_VERSION}}'
          cache: true

      - name: Resolve simulator target
        id: sim
        shell: bash
        run: |
          set -euo pipefail
          # 러너 이미지의 Xcode / runtime 버전은 시점에 따라 바뀐다.
          # 특정 버전을 하드코딩하지 말고 실행 시점에 동적으로 조회한다.
          xcrun simctl list runtimes
          bash scripts/ios/simctl_discover.sh | tee "$RUNNER_TEMP/simctl-discovery.txt"
          udid="$(awk -F= '/^SIMULATOR_UDID=/{print $2}' "$RUNNER_TEMP/simctl-discovery.txt" | tail -n 1)"
          if [[ -z "$udid" ]]; then
            echo "::error title=BLOCKED_SIMULATOR_DISCOVERY::No usable iOS Simulator matching minimum $IOS_MIN_VERSION was found on this runner."
            exit 1
          fi
          echo "SIMULATOR_UDID=$udid" >> "$GITHUB_OUTPUT"
          xcrun simctl boot "$udid" || true
          xcrun simctl bootstatus "$udid" -b
          echo "SIMULATOR_BOOT_PASS: PASS"

      - name: Inject backend configuration without logging secrets
        shell: bash
        run: |
          set -euo pipefail
          # BACKEND_KIND={{BACKEND_KIND}}
          # 'firebase-only' 인 앱은 BACKEND_URL/BACKEND_ANON_KEY 블록을 삭제하고,
          # 'supabase-only' 인 앱은 Firebase plist 블록을 삭제한다.
          # 'none' 인 앱은 이 스텝 전체를 삭제한다.
          umask 077
          missing=()
          for name in FIREBASE_PLIST_BASE64 BACKEND_URL BACKEND_ANON_KEY; do
            if [[ -z "${!name:-}" ]]; then missing+=("$name"); fi
          done
          if (( ${#missing[@]} )); then
            echo "::error title=BLOCKED_BACKEND_CONFIG::missing backend configuration secrets: ${missing[*]}"
            exit 1
          fi
          printf '%s' "$FIREBASE_PLIST_BASE64" | base64 --decode > ios/Runner/GoogleService-Info.plist
          plist_sha256="$(shasum -a 256 ios/Runner/GoogleService-Info.plist | awk '{print $1}')"
          echo "Firebase plist present: yes"
          echo "Firebase plist SHA-256: $plist_sha256"
          echo "Backend URL secret present: yes (length ${#BACKEND_URL})"
          echo "Backend anon key secret present: yes (length ${#BACKEND_ANON_KEY})"
          echo "BACKEND_CONFIG_PASS: PASS"

      - name: Build for simulator
        shell: bash
        run: |
          set -euo pipefail
          flutter pub get
          pod install --project-directory=ios
          # HAS_MAP={{HAS_MAP}} — 지도 SDK 를 쓰는 앱은 이 빌드가 첫 실측 지점이다.
          # 지도 SDK 가 iOS Simulator(arm64) 슬라이스를 제공하지 않으면 여기서 링크 에러가 난다.
          # 그 경우 QA 매트릭스의 지도 항목 분류를 PHYSICAL_DEVICE_REQUIRED 로 1회 갱신한다.
          flutter build ios --simulator --debug
          test -d build/ios/iphonesimulator/Runner.app || {
            echo "::error title=BLOCKED_SIMULATOR_BUILD::Simulator build did not produce Runner.app."
            exit 1
          }
          echo "SIMULATOR_BUILD_PASS: PASS"

      # =========================================================================
      # E2E 실행 방식 — 두 갈래가 있고, 이 템플릿은 어느 쪽도 "정답"으로 주지 않는다.
      # -------------------------------------------------------------------------
      # 아래 스텝은 (A) 방식을 쓴다. 앱마다 직접 선택하고, 선택 근거를 남겨라.
      #
      # (A) `flutter test integration_test` — Dart 테스트가 VM Service 로 앱에 attach
      #     장점: 설정이 단순하고 Dart 로 단언을 쓴다. CocoaPods 타깃 분리가 불필요.
      #     알려진 실패 모드: **이 CI 환경에서 attach 가 영구 hang 될 수 있다.**
      #       증상 — 앱은 뜨는데 드라이버가 붙지 못하고 flow body 로그가 전혀 남지 않은 채
      #       job timeout 까지 대기한다. flow 별 단계 근거가 없어 원인 귀속이 불가능해진다.
      #     완화: 반드시 외부 watchdog 로 시간 상한을 걸고(무한 대기 금지),
      #           flow 별 stage evidence(APP_BUILD/INSTALL/LAUNCH/READY/ATTACH/DISCOVERY/EXEC)를
      #           개별로 남겨라. 단일 대기 타임아웃만 두면 아무것도 배우지 못한다.
      #
      # (B) native XCTest (`xcodebuild test-without-building`)
      #     장점: 실패 지점이 stage 단위로 드러나고 시뮬레이터 안에서 실제로 실행된다.
      #     알려진 실패 모드: **test discovery 가 개시되지 않고 exit 65.**
      #       증상 — `Test runner never began executing tests after launching`.
      #       앱 빌드/설치/실행/ready 와 xctest 번들 로드까지 전부 PASS 인데
      #       testmanagerd 연결 단계에서 멈춘다. 앱 코드 결함이 아니라 러너 인프라 문제라
      #       저장소에서 고칠 수단이 없을 수 있다.
      #     전제: RunnerTests 를 CocoaPods 상 별도 타깃으로 격리해야 한다(아래 참고 노트).
      #
      # 원본 앱 실측: (A) 로 시작해 attach 무한 대기를 만났고, (B) 로 전환해
      # 링크 그래프 문제를 4회에 걸쳐 해소했으나 최종적으로 discovery 미개시에 막혔다.
      # 두 방식 모두 그 앱에서는 아직 FLOW 를 통과시키지 못했다.
      # 판정 기록: 원본 저장소의 `docs/ios/XCTEST_STOP_LOSS_DECISION.md`.
      #
      # >> 그래서 이 템플릿은 (B) 를 기본값으로 물려주지 않는다.
      # >> 원본 앱에서 통과가 확인되지 않은 구성을 다음 앱의 기본값으로 삼으면
      # >> 검증되지 않은 부채를 복제하는 것이다.
      # >> 다음 앱은 위 두 실패 모드를 알고 스스로 선택하라.
      #
      # 참고 노트 — (B) 를 선택할 때만 필요한 RunnerTests CocoaPods 격리 토폴로지:
      #   - Podfile 을 top-level `target 'Runner' do` + 그 안에 중첩된
      #     `target 'RunnerTests' do` / `inherit! :search_paths` 형태로 구성한다.
      #     (원본 앱 실제 구성: `ios/Podfile` 의 해당 target 블록)
      #     이렇게 하지 않으면 RunnerTests 링크 그래프가 앱 전체 pod 집합을 끌어와
      #     Runner 호스트와 중복 클래스가 생기고 discovery 가 깨진다.
      #   - RunnerTests 가 커스텀 Flutter xcconfig 를 쓰면 Pods 지원 xcconfig 가
      #     누락된다. 타깃 전용 xcconfig 를 별도로 둔다
      #     (예: `ios/Flutter/RunnerTests-{Debug,Profile,Release}.xcconfig`).
      #   - `integration_test` pod 를 명시 추가할 때는 절대 경로가 아니라
      #     Flutter helper 호환 상대 경로(`.symlinks/plugins/integration_test/ios`)를 쓴다.
      #     절대/상대 중복 선언은 pod install 단계에서 거부된다.
      #   - 그럼에도 Runner 호스트가 이미 `integration_test` 를 링크하고 있으면
      #     중복이 남는다. 호스트와 테스트 번들 양쪽의 링크 목록을 실제로 확인하라.
      # =========================================================================
      - name: Run integration_test E2E flows
        shell: bash
        env:
          SIMULATOR_UDID: ${{ steps.sim.outputs.SIMULATOR_UDID }}
        run: |
          set -euo pipefail
          failed_flows=()
          for flow in $E2E_FLOWS; do
            echo "::group::$flow"
            if flutter test integration_test \
                 --dart-define="E2E_FLOW=$flow" \
                 -d "$SIMULATOR_UDID"; then
              echo "${flow}_PASS: PASS"
            else
              echo "::error title=BLOCKED_E2E_FLOW::$flow failed on the simulator."
              failed_flows+=("$flow")
            fi
            echo "::endgroup::"
          done
          if (( ${#failed_flows[@]} )); then
            echo "::error title=BLOCKED_E2E_SUITE::failed flows: ${failed_flows[*]}"
            exit 1
          fi
          echo "E2E_SUITE_PASS: PASS"

      - name: Verify deep link handling on the booted simulator
        shell: bash
        env:
          SIMULATOR_UDID: ${{ steps.sim.outputs.SIMULATOR_UDID }}
        run: |
          set -euo pipefail
          xcrun simctl install "$SIMULATOR_UDID" build/ios/iphonesimulator/Runner.app
          installed_path="$(xcrun simctl get_app_container "$SIMULATOR_UDID" "$IOS_BUNDLE_ID" app)"
          if [[ -z "$installed_path" ]]; then
            echo "::error title=BLOCKED_SIMULATOR_INSTALL::App container for $IOS_BUNDLE_ID was not found after install."
            exit 1
          fi
          xcrun simctl launch "$SIMULATOR_UDID" "$IOS_BUNDLE_ID"
          # URL scheme 자체가 실제로 열리는지 확인한다(라우팅 단언은 integration_test 가 담당).
          xcrun simctl openurl "$SIMULATOR_UDID" "$IOS_URL_SCHEME://" || {
            echo "::error title=BLOCKED_DEEP_LINK::simctl openurl failed for scheme '$IOS_URL_SCHEME'."
            exit 1
          }
          echo "DEEP_LINK_OPEN_PASS: PASS"

      - name: Verify permission-denied branches via simctl privacy
        shell: bash
        env:
          SIMULATOR_UDID: ${{ steps.sim.outputs.SIMULATOR_UDID }}
        run: |
          set -euo pipefail
          # 기능 플래그가 false 인 권한은 아래 목록에서 줄을 삭제한다.
          # HAS_MICROPHONE={{HAS_MICROPHONE}} / HAS_PHOTOS={{HAS_PHOTOS}} / HAS_LOCATION={{HAS_LOCATION}}
          for service in microphone photos location; do
            xcrun simctl privacy "$SIMULATOR_UDID" revoke "$service" "$IOS_BUNDLE_ID" || {
              echo "::error title=BLOCKED_PRIVACY_TOGGLE::simctl privacy revoke failed for '$service'."
              exit 1
            }
            xcrun simctl privacy "$SIMULATOR_UDID" grant "$service" "$IOS_BUNDLE_ID" || {
              echo "::error title=BLOCKED_PRIVACY_TOGGLE::simctl privacy grant failed for '$service'."
              exit 1
            }
          done
          echo "PRIVACY_TOGGLE_PASS: PASS"

      - name: Preserve simulator E2E artifacts
        if: ${{ always() }}
        uses: actions/upload-artifact@v4
        with:
          name: {{APP_NAME}}-ios-simulator-e2e-${{ github.run_number }}
          path: |
            build/ios/iphonesimulator/**/*.log
            integration_test/**/screenshots/**
          if-no-files-found: warn
          retention-days: 14

      - name: Cleanup injected configuration
        if: ${{ always() }}
        shell: bash
        env:
          SIMULATOR_UDID: ${{ steps.sim.outputs.SIMULATOR_UDID }}
        run: |
          set +e
          rm -f ios/Runner/GoogleService-Info.plist
          xcrun simctl uninstall "${SIMULATOR_UDID:-}" "$IOS_BUNDLE_ID" >/dev/null 2>&1
          xcrun simctl shutdown "${SIMULATOR_UDID:-}" >/dev/null 2>&1
          echo "Cleanup gate executed."
